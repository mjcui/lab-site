---
import { b } from '../../utils/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { venueMeta } from '../../utils/paper-venue';

const paperEntries = await getCollection('papers');
const papers = paperEntries
  .map((e) => ({ slug: e.slug, ...e.data }))
  .sort((a, c) => c.year - a.year || a.title.localeCompare(c.title));

const years = [...new Set(papers.map((p) => p.year))].sort((a, d) => d - a);
const papersByYear = Object.fromEntries(years.map((y) => [y, papers.filter((p) => p.year === y)]));

const pageDesc = 'Browse our lab papers and publication metadata.';
---
<BaseLayout title="Papers" desc={pageDesc} lang="en" pathPrefix="/en">
  <section class="page-head" data-reveal>
    <h1 class="page-title">Papers</h1>
    <p class="page-sub">{papers.length} selected publications {years.length} years</p>
  </section>

  <section class="filter-wrap" data-list-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-list-search
      placeholder="Search title / authors / venue / year..."
      aria-label="Search papers"
    />
    <p class="empty-state" data-empty-state hidden>No matching paper found. Try another keyword.</p>

    <div class="papers-timeline">
      {years.map((year) => (
        <div class="paper-year-group" data-list-group>
          <div class="paper-year-rail">
            <span class="paper-year-num">{year}</span>
          </div>
          <div class="paper-year-items">
            {papersByYear[year].map((p) => {
              const m = venueMeta(p.venue, 'en');
              const hasLink = Boolean(p.links?.online || p.links?.pdf);
              return (
                <a
                  href={b(`/en/papers/${p.slug}/`)}
                  class={`paper-row card-hover${m.top ? ' is-top' : ''}`}
                  data-list-card
                  data-search-text={`${p.title} ${p.authors || ''} ${p.venue} ${p.year}`}
                >
                  <div class="paper-row-head">
                    <span class={`venue-tag ${m.cls}`}>{m.tag}</span>
                    {hasLink && <span class="paper-link-ico" aria-hidden="true">↗</span>}
                  </div>
                  <h3 class="paper-title">{p.title}</h3>
                  <p class="paper-meta">{p.venue}{p.authors ? ` ${p.authors}` : ''}</p>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
