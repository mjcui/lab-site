---
import { b } from '../../utils/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageDesc = 'Our ongoing and completed projects are primarily NSFC (National Natural Science Foundation of China) grants and industry (horizontal) collaborations. Content is being organized.';
---
<BaseLayout title="Projects" desc={pageDesc} lang="en" pathPrefix="/en">
  <section class="page-head" data-reveal>
    <h1 class="page-title">Projects</h1>
  </section>

  <section class="card detail-hero" data-reveal>
    <span class="badge-muted">In progress</span>
    <h2 class="mt-4">NSFC Grants &amp; Industry (Horizontal) Projects</h2>
    <p class="mt-4">Our ongoing and completed projects are primarily National Natural Science Foundation of China (NSFC) grants and industry (horizontal) collaborations. This section is being organized and will go live once specific project information is added.</p>
    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={b('/en/')}>Back to Home</a>
      <a class="btn btn-ghost" href={b('/en/papers/')}>View Papers</a>
    </div>
  </section>
</BaseLayout>
