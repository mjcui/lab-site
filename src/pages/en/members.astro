---
import { b } from '../../utils/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resolveMemberAvatar } from '../../utils/member-avatar';
import { pickI18nText } from '../../utils/i18n-text';

const memberEntries = await getCollection('members');
const roleOrder = ['Professor, Doctoral Supervisor', 'PhD', 'Master', 'RA'];
const roleRank = new Map(roleOrder.map((role, index) => [role, index]));
const currentStatuses = ['Current', 'Active'];
const formerStatuses = ['Alumni', 'Former'];
const leadRoleKeywordsEn = ['pi', 'advisor', 'professor', 'supervisor', 'faculty', 'director', 'lead'];

function isLeadRoleEn(roleEn: string) {
  const role = (roleEn || '').toLowerCase();
  return leadRoleKeywordsEn.some((keyword) => role.includes(keyword));
}

function getRoleRankEn(roleEn: string) {
  const exact = roleRank.get(roleEn);
  if (typeof exact === 'number') {
    return exact;
  }
  const role = (roleEn || '').toLowerCase();
  if (isLeadRoleEn(roleEn)) {
    return 0;
  }
  if (role.includes('phd') || role.includes('doctoral')) {
    return 1;
  }
  if (role.includes('master')) {
    return 2;
  }
  if (role === 'ra' || role.includes('research assistant') || role.includes('assistant')) {
    return 3;
  }
  return Number.MAX_SAFE_INTEGER;
}

function resolveStatusGroup(roleEn: string, statusEn: string) {
  if (isLeadRoleEn(roleEn)) {
    return 0;
  }
  if (currentStatuses.includes(statusEn)) {
    return 1;
  }
  if (formerStatuses.includes(statusEn)) {
    return 2;
  }
  return 1;
}

const membersWithId = memberEntries
  .map((e) => ({
    ...e.data,
    id: e.data.id ?? e.slug,
    nameText: pickI18nText(e.data.name, 'en'),
    areaText: pickI18nText(e.data.area, 'en'),
    honorText: pickI18nText(e.data.honor, 'en'),
    honorChips: (pickI18nText(e.data.honor, 'en') || '').split(/[、,]/).map((s) => s.trim()).filter(Boolean),
    researchText: pickI18nText(e.data.research, 'en'),
    statusText: pickI18nText(e.data.status, 'en'),
    avatarResolved: resolveMemberAvatar(e.data),
  }))
  .sort((a, b) => {
    const groupA = resolveStatusGroup(a.role.en, a.statusText);
    const groupB = resolveStatusGroup(b.role.en, b.statusText);
    if (groupA !== groupB) {
      return groupA - groupB;
    }
    const rankA = getRoleRankEn(a.role.en);
    const rankB = getRoleRankEn(b.role.en);
    return rankA - rankB || a.nameText.localeCompare(b.nameText);
  });

// Display grouping: Faculty → PhD Students → Master Students → Alumni (alumni grouped separately at the end)
function displayGroupEn(roleEn: string, statusEn: string) {
  if (isLeadRoleEn(roleEn)) return 'Faculty';
  if (formerStatuses.includes(statusEn)) return 'Graduates';
  return roleEn; // 'PhD Student' / 'Master Student' / 'RA'
}
// Fall back to identity flags so the PI never disappears when role wording changes.
function isLeadMember(m: (typeof membersWithId)[number]) {
  if (m.id === 'prof-cui') return true;
  if (m.honorLines) return true;
  return isLeadRoleEn(m.role?.en ?? '');
}
const leadMember = membersWithId.find(isLeadMember);
const nonLeadMembers = membersWithId.filter((m) => !isLeadMember(m));
// 'Faculty' is a fallback group so the PI never vanishes from the list.
const groupOrderEn = ['Faculty', 'PhD Student', 'Master Student', 'Undergraduate', 'RA', 'Graduates'];
const memberGroups = groupOrderEn
  .filter((key) => nonLeadMembers.some((m) => displayGroupEn(m.role.en, m.statusText) === key))
  .map((key) => {
    const title =
      key === 'PhD Student' ? 'PhD Students' :
      key === 'Master Student' ? 'Master Students' :
      key === 'Undergraduate' ? 'Undergraduates' :
      key === 'RA' ? 'Research Assistants' :
      key;
    return { title, members: nonLeadMembers.filter((m) => displayGroupEn(m.role.en, m.statusText) === key) };
  });
const pageDesc = 'Browse our lab members and role groups.';
---

<BaseLayout title="Members" desc={pageDesc} lang="en" pathPrefix="/en">
  <section class="page-head" data-reveal>
    <h1 class="page-title">Members</h1>
    <p class="page-sub">Lab lead, current and graduate members.</p>
  </section>

  <section class="filter-wrap" data-members-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-member-search
      placeholder="Search members by name or research area..."
      aria-label="Search members"
    />
    <p class="empty-state" data-empty-state hidden>No matching members. Try a different keyword.</p>

    {leadMember && (
      <div
        class="member-hero"
        data-member-card
        data-name={leadMember.nameText}
        data-area={leadMember.honorText || leadMember.areaText}
        data-role={leadMember.role.en}
        data-reveal
      >
        <div class="member-hero-media">
          <img
            class="member-hero-avatar"
            src={leadMember.avatarResolved}
            alt={`${leadMember.nameText} avatar`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="member-hero-body">
          <h2 class="member-hero-name">{leadMember.nameText}</h2>
          <p class="member-hero-role">{leadMember.role.en}</p>
          <div class="member-hero-chips">
            {leadMember.honorChips.map((c) => <span class="member-hero-chip">{c}</span>)}
          </div>
          {leadMember.researchText && <p class="member-hero-bio">{leadMember.researchText}</p>}
          <div class="member-hero-links">
            <a class="member-hero-link is-primary" href={b(`/en/members/${leadMember.id}/`)}>Profile →</a>
            {leadMember.links?.email && (
              <a class="member-hero-link" href={`mailto:${leadMember.links.email}`}>Email</a>
            )}
            {leadMember.links?.scholar && (
              <a class="member-hero-link" href={leadMember.links.scholar} target="_blank" rel="noopener">Google Scholar</a>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="members-groups">
      {memberGroups.map((group) => (
        <div class="member-group" data-member-group data-reveal>
          <h2 class="member-group-title">{group.title}</h2>
          <div class="grid grid-3">
            {group.members.map((m) => (
              <a
                href={b(`/en/members/${m.id}/`)}
                class="card card-hover card-link member-card"
                data-member-card
                data-name={m.nameText}
                data-area={m.areaText}
                data-role={m.role.en}
                data-reveal
              >
                <img
                  class="member-avatar"
                  src={m.avatarResolved}
                  alt={`${m.nameText} avatar`}
                  loading="lazy"
                  decoding="async"
                />
                <h3>{m.nameText}</h3>
                <p class="member-role"><span class="badge-muted">{m.role.en}</span></p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .members-groups {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .member-group-title {
    font-size: 1.3rem;
    color: var(--primary);
    border-left: 4px solid var(--primary);
    padding-left: 12px;
    margin: 0 0 18px;
    font-weight: 700;
  }
</style>
