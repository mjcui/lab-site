---
import { b, asset } from '../../utils/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickNav from '../../components/QuickNav.astro';
import siteEn from '../../data/site.en.json';

const t = siteEn;
const highlightLinks = ['/en/members/', '/en/papers/', '/en/join/'];
---
<BaseLayout title="Home" desc={t.home.intro} lang="en" pathPrefix="/en">
  <section class="card hero hero-photo hero-center mb-5" data-reveal>
    <img class="hero-media" src={asset('/images/tju-gate1895.jpg')} alt="Tianjin University 1895 Gate, Beiyang Park Campus" />
    <img class="hero-badge" src={asset('/images/tju_badge_white.svg')} alt="Tianjin University badge" width="88" height="88" />
    <div class="hero-affil" data-reveal data-reveal-delay="40">Tianjin University · School of Electrical and Information Engineering</div>
    <h1 class="hero-title" data-reveal data-reveal-delay="70">{t.siteName}</h1>
    <p class="hero-subtitle" data-reveal data-reveal-delay="120">{t.home.intro}</p>
    <div class="hero-actions" data-reveal data-reveal-delay="180">
      <a class="btn btn-gold" href={b('/en/join/')}>Join Us</a>
      <a class="btn btn-ghost" href={b('/en/papers/')}>View Papers</a>
      <a class="btn btn-ghost" href={b('/en/projects/')}>Explore Projects</a>
      <a class="btn btn-ghost" href={b('/en/members/')}>Meet Members</a>
    </div>
  </section>

  <section class="card home-about mb-5" data-reveal>
    <div class="home-about-media">
      <img src={asset('/images/tju-nine.jpg')} alt="Tianjin University Ninth Teaching Building" loading="lazy" decoding="async" />
    </div>
    <div class="home-about-body">
      <div class="page-head"><h2 class="page-title">{t.home.platform.title}</h2></div>
      <p class="home-about-school">{t.home.platform.school}</p>
      <p class="home-about-desc">{t.home.platform.desc}</p>
      <ul class="home-about-tags">
        {t.home.platform.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </section>

  <section class="mb-5">
    <div class="page-head" data-reveal>
      <h2 class="page-title">{t.home.sections?.highlights ?? 'Highlights'}</h2>
    </div>
    <div class="grid grid-3" data-reveal-group>
      {t.home.highlights.map((h, i) => (
        <article class="card card-hover card-clickable" data-reveal data-reveal-order={String(i)}>
          <a class="card-link-overlay" href={highlightLinks[i] ?? '/en/news'} aria-label={`View ${h.title}`}></a>
          <h3>{h.title}</h3>
          <p class="mt-4">{h.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="card" data-reveal>
    <h2>{t.home.quick}</h2>
    <QuickNav links={t.home.quickLinks} prefix="/en" />
  </section>
</BaseLayout>
