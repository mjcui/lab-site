---
import { b, asset } from '../../utils/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { buildLocalizedNews } from '../../utils/news-localized';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  const localized = buildLocalizedNews(allNews).filter((item) => item.entry.zh);

  return localized.map((item, idx) => {
    const related = localized
      .filter((n) => n.slug !== item.slug)
      .slice(0, 3)
      .map((n) => ({
        slug: n.slug,
        date: n.date,
        title: n.title.zh || n.title.en || n.slug,
        cover: n.cover,
        categoryZh: n.category?.zh,
      }));
    const prev = localized[idx + 1];
    const next = localized[idx - 1];
    const bodyLen = ((item.entry.zh as unknown as { body?: string })?.body?.length) || 0;
    const readingMinutes = Math.max(1, Math.round(bodyLen / 350));
    return {
      params: { slug: item.slug },
      props: {
        entry: item.entry.zh!,
        title: item.title.zh || item.title.en || item.slug,
        date: item.date,
        cover: item.cover,
        categoryZh: item.category?.zh,
        readingMinutes,
        localeAlternates: {
          zh: `/news/${item.slug}/`,
          en: item.entry.en ? `/en/news/${item.slug}/` : undefined,
          xDefault: `/news/${item.slug}/`,
        },
        related,
        prev: prev
          ? { slug: prev.slug, title: prev.title.zh || prev.title.en || prev.slug }
          : undefined,
        next: next
          ? { slug: next.slug, title: next.title.zh || next.title.en || next.slug }
          : undefined,
      },
    };
  });
}

const { entry, title, date, categoryZh, readingMinutes, related, prev, next, localeAlternates } = Astro.props;
const { Content } = await render(entry);
const pageDesc = `${title}${date ? ` ${date}` : ''}`;
---
<BaseLayout title={title} desc={pageDesc} lang="zh" pathPrefix="" ogType="article" localeAlternates={localeAlternates}>
  <section class="detail-shell">
    <nav class="news-crumbs" data-reveal>
      <a href={b('/')}>首页</a> / <a href={b('/news/')}>新闻动态</a>
    </nav>

    <header class="detail-hero" data-reveal>
      <h1 class="page-title">{title}</h1>
      <div class="news-detail-meta">
        {categoryZh && <span class="news-tag">{categoryZh}</span>}
        {date && <span class="badge-muted">{date}</span>}
        <span class="news-card__date">约 {readingMinutes} 分钟阅读</span>
      </div>
    </header>

    <article class="card detail-content news-article news-detail-body" data-reveal>
      <Content />
    </article>

    <section class="detail-section" data-reveal>
      <h2>更多新闻</h2>
      <div class="news-related">
        {related.map((n) => (
          <a class="news-card card-hover" href={b(`/news/${n.slug}/`)}>
            <div class="news-card__media">
              {n.cover ? (
                <img src={asset(n.cover)} alt={n.title} loading="lazy" />
              ) : (
                <div class="news-card__ph">{n.categoryZh || '新闻'}</div>
              )}
            </div>
            <div class="news-card__body">
              <div class="news-card__meta">
                {n.categoryZh && <span class="news-tag">{n.categoryZh}</span>}
                <span class="news-card__date">{n.date}</span>
              </div>
              <h3 class="news-card__title">{n.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <nav class="news-nav" data-reveal>
      {prev ? (
        <a href={b(`/news/${prev.slug}/`)}>
          <span class="news-nav__dir">← 上一篇</span>
          <span class="news-nav__title">{prev.title}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={b(`/news/${next.slug}/`)} style="text-align:right">
          <span class="news-nav__dir">下一篇 →</span>
          <span class="news-nav__title">{next.title}</span>
        </a>
      ) : <span></span>}
    </nav>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={b('/news/')} data-history-back>返回新闻列表</a>
      <a class="btn btn-ghost" href={b('/')}>回到首页</a>
    </div>
  </section>
</BaseLayout>
