---
import { b, asset } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { summarizeText } from '../utils/seo';
import Badge from '../components/Badge.astro';

const joinEntries = await getCollection('join');
const entry =
  joinEntries.find((item) => item.id === 'recruitment/overview_cn.md') ||
  joinEntries.find((item) => /_cn\.md$/i.test(item.id));

if (!entry) {
  throw new Error('Missing Chinese join content: src/content/join/**/_cn.md');
}

const { Content } = await render(entry);
const pageTitle = entry.data.title || '招生与合作';
const pageDesc = summarizeText(entry.body) || '查看课题组的招生与合作信息。';
---
<BaseLayout title={pageTitle} desc={pageDesc} lang="zh" pathPrefix="">
  <section class="detail-shell">
    <article class="card join-hero" data-reveal>
      <div class="join-hero__media">
        <img src={asset('/images/join-hero-gate.webp')} alt="天津大学校门（校名清晰，招生身份感）" />
      </div>
      <div class="join-hero__panel">
        <Badge class="hero-badge" variant="blue" />
        <div class="hero-affil">天津大学 电气自动化与信息工程学院</div>
        <h1 class="hero-title">{pageTitle}</h1>
        <p class="hero-subtitle">欢迎对新能源电力系统、智能电网与人工智能交叉研究充满热情的优秀学子加入我们。</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="#recruit">招生详情</a>
          <a class="btn btn-ghost" href={b('/members/')}>认识团队</a>
        </div>
      </div>
    </article>

    <article class="card detail-content news-article" id="recruit" data-reveal>
      <Content />
    </article>

    <section class="join-gallery" data-reveal>
      <div class="join-gallery__head">
        <div class="join-gallery__title">科研平台与校园</div>
        <div class="join-gallery__sub">在真实场景中做有意义的研究</div>
      </div>
      <div class="join-gallery__grid">
        <figure class="join-gallery__item">
          <img class="join-gallery__img" src={asset('/images/microgrid-base.webp')} alt="微电网国际合作基地（光伏户外实验场景）" loading="lazy" decoding="async" />
          <figcaption class="join-gallery__cap">微电网国际合作基地 新能源与智能电网科研平台</figcaption>
        </figure>
        <figure class="join-gallery__item">
          <img class="join-gallery__img" src={asset('/images/smart-grid-lab.webp')} alt="智能电网教育部重点实验室 控制与实验平台" loading="lazy" decoding="async" />
          <figcaption class="join-gallery__cap">智能电网教育部重点实验室 控制与实验平台</figcaption>
        </figure>
        <figure class="join-gallery__item">
          <img class="join-gallery__img" src={asset('/images/join-gallery-dome.webp')} alt="天津大学校园穹顶建筑（百年学府的治学氛围）" loading="lazy" decoding="async" />
          <figcaption class="join-gallery__cap">天津大学校园 百年学府的治学氛围</figcaption>
        </figure>
      </div>
    </section>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={b('/')}>返回首页</a>
      <a class="btn btn-ghost" href={b('/members/')}>查看成员</a>
    </div>
  </section>
</BaseLayout>
