---
import { b, asset } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickNav from '../components/QuickNav.astro';
import siteZh from '../data/site.zh.json';

const t = siteZh;
const highlightLinks = ['/members/', '/papers/', '/join/'];
---
<BaseLayout title="首页" desc={t.home.intro} lang="zh" pathPrefix="">
  <section class="card hero hero-photo hero-center mb-5" data-reveal>
    <img class="hero-media" src={asset('/images/tju-gate1895.jpg')} alt="天津大学北洋园校区 1895 门楼" />
    <img class="hero-badge" src={asset('/images/tju_badge_white.svg')} alt="天津大学校徽" width="88" height="88" />
    <div class="hero-affil" data-reveal data-reveal-delay="40">天津大学 · 电气自动化与信息工程学院</div>
    <h1 class="hero-title" data-reveal data-reveal-delay="70">{t.siteName}</h1>
    <p class="hero-subtitle" data-reveal data-reveal-delay="120">{t.home.intro}</p>
    <div class="hero-actions" data-reveal data-reveal-delay="180">
      <a class="btn btn-gold" href={b('/join/')}>招生合作</a>
      <a class="btn btn-ghost" href={b('/papers/')}>查看论文</a>
      <a class="btn btn-ghost" href={b('/projects/')}>查看项目</a>
      <a class="btn btn-ghost" href={b('/members/')}>了解成员</a>
    </div>
  </section>

  <section class="card home-about mb-5" data-reveal>
    <div class="home-about-media">
      <img src={asset('/images/tju-nine.jpg')} alt="天津大学第九教学楼" loading="lazy" decoding="async" />
    </div>
    <div class="home-about-body">
      <div class="page-head"><h2 class="page-title">{t.home.platform.title}</h2></div>
      <p class="home-about-school">{t.home.platform.school}</p>
      <p class="home-about-desc">{t.home.platform.desc}</p>
      <ul class="home-about-tags">
        {t.home.platform.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </section>

  <section class="mb-5">
    <div class="page-head" data-reveal>
      <h2 class="page-title">{t.home.sections?.highlights ?? '重点信息'}</h2>
    </div>
    <div class="grid grid-3" data-reveal-group>
      {t.home.highlights.map((h, i) => (
        <article class="card card-hover card-clickable" data-reveal data-reveal-order={String(i)}>
          <a class="card-link-overlay" href={highlightLinks[i] ?? '/news'} aria-label={`查看 ${h.title} 详情`}></a>
          <h3>{h.title}</h3>
          <p class="mt-4">{h.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="card" data-reveal>
    <h2>{t.home.quick}</h2>
    <QuickNav links={t.home.quickLinks} />
  </section>
</BaseLayout>
