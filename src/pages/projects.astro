---
import { b } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageDesc = '课题组在研与结题项目以国家自然科学基金（国自然）及横向课题为主，内容整理中。';
---
<BaseLayout title="项目" desc={pageDesc} lang="zh" pathPrefix="">
  <section class="page-head" data-reveal>
    <h1 class="page-title">项目</h1>
  </section>

  <section class="card detail-hero" data-reveal>
    <span class="badge-muted">内容整理中</span>
    <h2 class="mt-4">国家自然科学基金（国自然）及横向课题</h2>
    <p class="mt-4">课题组在研与结题项目以国家自然科学基金（国自然）及横向课题为主。本栏目内容正在整理中，待补充具体项目信息后上线。</p>
    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={b('/')}>返回首页</a>
      <a class="btn btn-ghost" href={b('/papers/')}>查看论文</a>
    </div>
  </section>
</BaseLayout>
