---
import { b } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resolveMemberAvatar } from '../utils/member-avatar';
import { pickI18nText } from '../utils/i18n-text';

const memberEntries = await getCollection('members');
const roleOrder = ['教授、博士生导师', '博士生', '硕士生', '研究助理'];
const roleRank = new Map(roleOrder.map((role, index) => [role, index]));
const currentStatuses = ['在读', '在职'];
const formerStatuses = ['已毕业', '已离开'];
const leadRoleKeywordsZh = ['负责人', '导师', '教授', 'pi'];

function isLeadRoleZh(roleZh: string) {
  const role = (roleZh || '').toLowerCase();
  return leadRoleKeywordsZh.some((keyword) => role.includes(keyword));
}

function getRoleRankZh(roleZh: string) {
  const exact = roleRank.get(roleZh);
  if (typeof exact === 'number') {
    return exact;
  }
  const role = (roleZh || '').toLowerCase();
  if (isLeadRoleZh(roleZh)) {
    return 0;
  }
  if (role.includes('博士')) {
    return 1;
  }
  if (role.includes('硕士')) {
    return 2;
  }
  if (role.includes('研究助理') || role.includes('助理') || role.includes('ra')) {
    return 3;
  }
  return Number.MAX_SAFE_INTEGER;
}

function resolveStatusGroup(roleZh: string, statusZh: string) {
  if (isLeadRoleZh(roleZh)) {
    return 0;
  }
  if (currentStatuses.includes(statusZh)) {
    return 1;
  }
  if (formerStatuses.includes(statusZh)) {
    return 2;
  }
  return 1;
}

const membersWithId = memberEntries
  .map((e) => ({
    ...e.data,
    id: e.data.id ?? e.slug,
    nameText: pickI18nText(e.data.name, 'zh'),
    areaText: pickI18nText(e.data.area, 'zh'),
    honorText: pickI18nText(e.data.honor, 'zh'),
    honorChips: (pickI18nText(e.data.honor, 'zh') || '').split(/[、,]/).map((s) => s.trim()).filter(Boolean),
    researchText: pickI18nText(e.data.research, 'zh'),
    statusText: pickI18nText(e.data.status, 'zh'),
    avatarResolved: resolveMemberAvatar({ ...e.data, id: e.slug }),
  }))
  .sort((a, b) => {
    const groupA = resolveStatusGroup(a.role.zh, a.statusText);
    const groupB = resolveStatusGroup(b.role.zh, b.statusText);
    if (groupA !== groupB) {
      return groupA - groupB;
    }
    const rankA = getRoleRankZh(a.role.zh);
    const rankB = getRoleRankZh(b.role.zh);
    return rankA - rankB || a.nameText.localeCompare(b.nameText);
  });

// 显示分组：导师 → 博士生 → 硕士生 → 已毕业（已毕业不按角色拆分，单独成栏置于末尾）
function displayGroupZh(roleZh: string, statusZh: string) {
  if (isLeadRoleZh(roleZh)) return '导师';
  if (formerStatuses.includes(statusZh)) return '毕业生';
  return roleZh; // 博士生 / 硕士生 / 研究助理
}
// 导师识别加身份兜底：角色文案若调整（或内容缓存异常），仍按 id / honorLines 锁定 PI，
// 避免 leadMember 落空后导师被排除、又不匹配任何分组而彻底从列表消失。
function isLeadMember(m: (typeof membersWithId)[number]) {
  if (m.id === 'prof-cui') return true;
  if (m.honorLines) return true;
  return isLeadRoleZh(m.role?.zh ?? '');
}
const leadMember = membersWithId.find(isLeadMember);
const nonLeadMembers = membersWithId.filter((m) => !isLeadMember(m));
// '导师' 作为兜底分组：万一 leadMember 仍为空，导师也能单独成组显示，不会蒸发。
const groupOrderZh = ['导师', '博士生', '硕士生', '本科生', '研究助理', '毕业生'];
const memberGroups = groupOrderZh
  .filter((title) => nonLeadMembers.some((m) => displayGroupZh(m.role.zh, m.statusText) === title))
  .map((title) => ({ title, members: nonLeadMembers.filter((m) => displayGroupZh(m.role.zh, m.statusText) === title) }));
const pageDesc = '查看课题组成员列表与角色分组。';
---

<BaseLayout title="成员" desc={pageDesc} lang="zh" pathPrefix="">
  <section class="page-head" data-reveal>
    <h1 class="page-title">成员列表</h1>
    <p class="page-sub">课题负责人与在读、毕业生成员。</p>
  </section>

  <section class="filter-wrap" data-members-filter-root data-reveal>
    <input
      class="filter-input"
      type="search"
      data-member-search
      placeholder="搜索成员姓名 / 研究方向..."
      aria-label="搜索成员"
    />
    <p class="empty-state" data-empty-state hidden>没有匹配的成员，请调整关键词。</p>

    {leadMember && (
      <div
        class="member-hero"
        data-member-card
        data-name={leadMember.nameText}
        data-area={leadMember.honorText || leadMember.areaText}
        data-role={leadMember.role.zh}
        data-reveal
      >
        <div class="member-hero-media">
          <img
            class="member-hero-avatar"
            src={leadMember.avatarResolved}
            alt={`${leadMember.nameText} 头像`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="member-hero-body">
          <h2 class="member-hero-name">{leadMember.nameText}</h2>
          <p class="member-hero-role">{leadMember.role.zh}</p>
          <div class="member-hero-chips">
            {leadMember.honorChips.map((c) => <span class="member-hero-chip">{c}</span>)}
          </div>
          {leadMember.researchText && <p class="member-hero-bio">{leadMember.researchText}</p>}
          <div class="member-hero-links">
            <a class="member-hero-link is-primary" href={b(`/members/${leadMember.id}/`)}>个人主页 →</a>
            {leadMember.links?.email && (
              <a class="member-hero-link" href={`mailto:${leadMember.links.email}`}>Email</a>
            )}
            {leadMember.links?.scholar && (
              <a class="member-hero-link" href={leadMember.links.scholar} target="_blank" rel="noopener">Google Scholar</a>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="members-groups">
      {memberGroups.map((group) => (
        <div class="member-group" data-member-group data-reveal>
          <h2 class="member-group-title">{group.title}</h2>
          <div class="grid grid-3">
            {group.members.map((m) => (
              <a
                href={b(`/members/${m.id}/`)}
                class="card card-hover card-link member-card"
                data-member-card
                data-name={m.nameText}
                data-area={m.areaText}
                data-role={m.role.zh}
                data-reveal
              >
                <img
                  class="member-avatar"
                  src={m.avatarResolved}
                  alt={`${m.nameText} 头像`}
                  loading="lazy"
                  decoding="async"
                />
                <h3>{m.nameText}</h3>
                <p class="member-role"><span class="badge-muted">{m.role.zh}</span></p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .members-groups {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .member-group-title {
    font-size: 1.3rem;
    color: var(--primary);
    border-left: 4px solid var(--primary);
    padding-left: 12px;
    margin: 0 0 18px;
    font-weight: 700;
  }
</style>
